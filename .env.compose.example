# Copy to .env next to docker-compose.yml on the VM (not committed).
ADMIN_USER=admin
ADMIN_PASSWORD=pick-a-strong-password
DEVICE_KEY=change-me-device-key
TIME_ZONE=Asia/Singapore
# Remote SSH tunnel (also open TCP 2222 in the VM firewall)
TUNNEL_PASSWORD=pick-another-strong-password
COMPOSE_PROFILES=ssh
# Max, the portal AI assistant (optional): a Claude API key. Empty = Max uses the built-in engine (portal data only).
ANTHROPIC_API_KEY=
# Barrier Control: MQTT broker on this VM. Turn it on with COMPOSE_PROFILES=ssh,mqtt and open TCP 8883 in the VM firewall.
# Barrier controllers connect to mqtts://mdm.gbotz.site:8883 with MQTT_USER / MQTT_PASSWORD. Empty MQTT_URL = barrier control off.
MQTT_USER=barrier
MQTT_PASSWORD=pick-a-strong-password
MQTT_URL=mqtt://mqtt:1883
# MQTT_DOMAIN=mdm.gbotz.site
