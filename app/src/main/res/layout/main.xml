<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: internet status (left), clock (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Portal server reachable? Set from DeviceService check-ins -->
                <TextView
                    android:id="@+id/serverStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Connection detail: Wi-Fi name, or Ethernet IP -->
                <TextView
                    android:id="@+id/netInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:drawablePadding="7dp"
                    android:gravity="center_vertical"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#1D2129"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

                <!-- Battery level, kept live by a battery receiver -->
                <TextView
                    android:id="@+id/battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_battery"
                    android:gravity="center_vertical"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

                <!-- 4-digit Device ID from the portal -->
                <TextView
                    android:id="@+id/deviceCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textColor="#1D2129"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Wallpaper logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:padding="40dp"
            android:scaleType="fitCenter"
            android:src="@drawable/wallpaper" />

        <!-- Allowed apps, picked from the admin menu -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4F5F7">

            <GridLayout
                android:id="@+id/apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:padding="12dp" />
        </ScrollView>

        <!-- Footer on every kiosk home screen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4F5F7"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:paddingTop="2dp"
            android:text="@string/footer"
            android:textColor="#9AA0A6"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- App pinning: shown for a few seconds before the app reopens -->
    <TextView
        android:id="@+id/single"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="48dp"
        android:background="#E61D2129"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- App pinning manual override: tap 6 times within 3 seconds, then the override PIN -->
    <View
        android:id="@+id/overrideCorner"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|start" />

    <!-- Invisible admin hotspot: tap 6 times within 3 seconds -->
    <View
        android:id="@+id/corner"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end" />
</FrameLayout>
