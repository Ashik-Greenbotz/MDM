<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: internet status (left), clock (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#1D2129"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Wallpaper logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:padding="40dp"
            android:scaleType="fitCenter"
            android:src="@drawable/wallpaper" />

        <!-- Allowed apps, picked from the admin menu -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4F5F7">

            <GridLayout
                android:id="@+id/apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:padding="12dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Invisible admin hotspot: tap 6 times within 3 seconds -->
    <View
        android:id="@+id/corner"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end" />
</FrameLayout>
