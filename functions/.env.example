# Copy to functions\.env (not committed). start-server.bat reads it; so does `firebase deploy`.
ADMIN_USER=admin
ADMIN_PASSWORD=pick-a-strong-password
# Must match server_key in app/src/main/res/values/server.xml (rebuild the app after changing it).
DEVICE_KEY=change-me-device-key
TIME_ZONE=Asia/Singapore
# Max, the portal AI assistant (optional). Without a key Max uses the built-in engine (portal data only).
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# Address search on OneMap (Singapore, free, no key) is on; ONEMAP=off turns it off.
